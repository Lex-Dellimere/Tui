// Shared helpers for the test programs.

import "std/io";
import "std/mem";
import "std/conv";

var g_checks: int32 = 0;
var g_fails: int32 = 0;

export fn t_ok(name: string, cond: bool) {
  g_checks = g_checks + 1;
  if (!cond) {
    g_fails = g_fails + 1;
    println("FAIL {name}");
  }
}

export fn t_eq(name: string, got: int64, want: int64) {
  g_checks = g_checks + 1;
  if (got != want) {
    g_fails = g_fails + 1;
    println("FAIL {name}: got {got}, want {want}");
  }
}

export fn t_str(name: string, got: string, want: string) {
  g_checks = g_checks + 1;
  if (got != want) {
    g_fails = g_fails + 1;
    println("FAIL {name}:\n--- got ---\n{got}\n--- want ---\n{want}\n");
  }
}

// xorshift64* so runs repeat.
var g_rng: uint64 = 88172645463325252;
export fn t_seed(s: uint64) { g_rng = s; if (g_rng == (uint64)0) { g_rng = 1; } }
export fn t_rand() -> uint64 {
  g_rng = g_rng ^ (g_rng >> 12);
  g_rng = g_rng ^ (g_rng << 25);
  g_rng = g_rng ^ (g_rng >> 27);
  return g_rng * (uint64)2685821657736338717;
}

export fn t_done(what: string) -> int32 {
  if (g_fails > 0) {
    println("{what}: {g_fails} of {g_checks} checks failed");
    return 1;
  }
  println("{what}: {g_checks} checks passed");
  return 0;
}

// A copy of s with each backtick turned into ESC (0x1b), so tests can
// write control sequences. The copy is never freed (tests are short).
export fn t_esc(s: string) -> string {
  var n: int64 = (int64)s.length;
  var p: uint8* = (uint8*)malloc(n + 1);
  for i: int64 in 0..n {
    var c: uint8 = (uint8)s[i];
    if (c == (uint8)96) { c = (uint8)27; }
    p[i] = c;
  }
  return str_from_bytes((cstring)p, n);
}

// The reverse, for printing output with ESC shown as a backtick.
export fn t_show(s: string) -> string {
  var n: int64 = (int64)s.length;
  var p: uint8* = (uint8*)malloc(n + 1);
  for i: int64 in 0..n {
    var c: uint8 = (uint8)s[i];
    if (c == (uint8)27) { c = (uint8)96; }
    p[i] = c;
  }
  return str_from_bytes((cstring)p, n);
}
