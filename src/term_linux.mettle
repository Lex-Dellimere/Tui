// The Linux terminal: raw mode with the TCGETS/TCSETS ioctls (the same
// flags as cfmakeraw), the window size with TIOCGWINSZ, and signals
// (SIGWINCH, SIGINT, SIGTERM, SIGHUP) read from a signalfd so they arrive
// as events in the same ppoll as the keyboard, with no signal handler.

import "std/linux";
import "std/linux_sys";

const TUI_TCGETS = 0x5401;
const TUI_TCSETS = 0x5402;
const TUI_TIOCGWINSZ = 0x5413;

export const TUI_SIGHUP = 1;
export const TUI_SIGINT = 2;
export const TUI_SIGTERM = 15;
export const TUI_SIGWINCH = 28;

export struct TuiTerm {
  in_fd: int64;
  out_fd: int64;
  own_fd: bool;        // in_fd came from opening /dev/tty
  sig_fd: int64;
  saved: uint32[16];   // termios before raw mode
  raw: bool;
  old_mask: uint64;
  masked: bool;
}

// Opens the controlling terminal. Returns 0 on success or -errno.
export fn tui_term_open(t: TuiTerm*) -> int64 {
  t->sig_fd = -1;
  var path: uint8[9] = [47, 100, 101, 118, 47, 116, 116, 121, 0];   // "/dev/tty"
  var fd: int64 = linux_openat(-100, &path[0], 2 | 0x80000, 0);   // O_RDWR | O_CLOEXEC
  if (fd >= 0) {
    t->in_fd = fd;
    t->out_fd = fd;
    t->own_fd = true;
  } else {
    t->in_fd = 0;
    t->out_fd = 1;
  }
  var r: int64 = syscall(LINUX_SYS_IOCTL, t->in_fd, TUI_TCGETS, &t->saved[0]);
  if (r < 0) { return r; }
  return 0;
}

export fn tui_term_raw(t: TuiTerm*) -> int64 {
  var raw: uint32[16];
  for i in 0..16 { raw[i] = t->saved[i]; }
  // c_iflag: IGNBRK BRKINT PARMRK ISTRIP INLCR IGNCR ICRNL IXON off.
  raw[0] = raw[0] & ~(uint32)(1 | 2 | 8 | 0x20 | 0x40 | 0x80 | 0x100 | 0x400);
  // c_oflag: OPOST off.
  raw[1] = raw[1] & ~(uint32)1;
  // c_cflag: CSIZE and PARENB off, CS8 on.
  raw[2] = (raw[2] & ~(uint32)(0x30 | 0x100)) | (uint32)0x30;
  // c_lflag: ECHO ECHONL ICANON ISIG IEXTEN off.
  raw[3] = raw[3] & ~(uint32)(8 | 0x40 | 2 | 1 | 0x8000);
  var cc: uint8* = (uint8*)&raw[0];
  cc[17 + 5] = (uint8)0;   // VTIME
  cc[17 + 6] = (uint8)1;   // VMIN
  var r: int64 = syscall(LINUX_SYS_IOCTL, t->in_fd, TUI_TCSETS, &raw[0]);
  if (r == 0) { t->raw = true; }
  return r;
}

export fn tui_term_restore(t: TuiTerm*) {
  if (t->raw) {
    syscall(LINUX_SYS_IOCTL, t->in_fd, TUI_TCSETS, &t->saved[0]);
    t->raw = false;
  }
}

// Blocks the signals we handle and opens a signalfd for them.
export fn tui_term_signals(t: TuiTerm*) -> int64 {
  var mask: uint64 = ((uint64)1 << (TUI_SIGWINCH - 1)) | ((uint64)1 << (TUI_SIGINT - 1))
    | ((uint64)1 << (TUI_SIGTERM - 1)) | ((uint64)1 << (TUI_SIGHUP - 1));
  var r: int64 = syscall(LINUX_SYS_RT_SIGPROCMASK, 0, &mask, &t->old_mask, 8);   // SIG_BLOCK
  if (r < 0) { return r; }
  t->masked = true;
  var fd: int64 = syscall(LINUX_SYS_SIGNALFD4, -1, &mask, 8, 0x800 | 0x80000);   // NONBLOCK | CLOEXEC
  if (fd < 0) { return fd; }
  t->sig_fd = fd;
  return 0;
}

export fn tui_term_close(t: TuiTerm*) {
  tui_term_restore(t);
  if (t->sig_fd >= 0) {
    linux_close(t->sig_fd);
    t->sig_fd = -1;
  }
  if (t->masked) {
    syscall(LINUX_SYS_RT_SIGPROCMASK, 2, &t->old_mask, 0, 8);   // SIG_SETMASK
    t->masked = false;
  }
  if (t->own_fd) {
    linux_close(t->in_fd);
    t->own_fd = false;
  }
}

// The window size in cells; 0 if unknown.
export fn tui_term_size(t: TuiTerm*, w: int32*, h: int32*) {
  var ws: uint16[4];
  *w = 0;
  *h = 0;
  if (syscall(LINUX_SYS_IOCTL, t->out_fd, TUI_TIOCGWINSZ, &ws[0]) == 0) {
    *w = (int32)ws[1];
    *h = (int32)ws[0];
  }
}

// Writes all n bytes, retrying on EINTR and short writes.
export fn tui_term_write(t: TuiTerm*, p: uint8*, n: int64) {
  var done: int64 = 0;
  while (done < n) {
    var r: int64 = linux_write(t->out_fd, p + done, n - done);
    if (r == -4 || r == -11) { continue; }   // EINTR, EAGAIN
    if (r <= 0) { return; }
    done = done + r;
  }
}

// Waits up to timeout_ms (-1: for good) for input or a signal.
// Sets *got_in and *got_sig; returns <0 on error, 0 on timeout.
export fn tui_term_wait(t: TuiTerm*, timeout_ms: int64, got_in: bool*, got_sig: bool*) -> int64 {
  var fds: LinuxPollFd[2];
  fds[0].fd = (int32)t->in_fd;
  fds[0].events = (int16)1;   // POLLIN
  fds[0].revents = (int16)0;
  fds[1].fd = (int32)t->sig_fd;
  fds[1].events = (int16)1;
  fds[1].revents = (int16)0;
  var nf: int64 = 1;
  if (t->sig_fd >= 0) { nf = 2; }
  var ts: int64[2];
  var tp: int64* = (int64*)0;
  if (timeout_ms >= 0) {
    ts[0] = timeout_ms / 1000;
    ts[1] = (timeout_ms % 1000) * 1000000;
    tp = &ts[0];
  }
  *got_in = false;
  *got_sig = false;
  var r: int64 = linux_ppoll(&fds[0], nf, tp);
  if (r == -4) { return 0; }
  if (r <= 0) { return r; }
  *got_in = fds[0].revents != (int16)0;
  if (nf == 2) { *got_sig = fds[1].revents != (int16)0; }
  return r;
}

export fn tui_term_read(t: TuiTerm*, p: uint8*, n: int64) -> int64 {
  return linux_read(t->in_fd, p, n);
}

// The next pending signal number, or 0.
export fn tui_term_next_signal(t: TuiTerm*) -> int32 {
  if (t->sig_fd < 0) { return 0; }
  var info: uint8[128];
  var r: int64 = linux_read(t->sig_fd, &info[0], 128);
  if (r < 128) { return 0; }
  var signo: uint32* = (uint32*)&info[0];
  return (int32)*signo;
}
